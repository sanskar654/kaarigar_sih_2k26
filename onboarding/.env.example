# ── Kaarigar Track A — Onboarding configuration ────────────────────
# Copy this file to ".env" and fill in your Twilio credentials.
# Without a .env file, the server will start but webhook calls will fail.

# ── Twilio Account Credentials ──────────────────────────────────────
# Find these at https://console.twilio.com (Account → API Keys & Tokens)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Twilio Phone Number ─────────────────────────────────────────────
# The number artisans dial. Buy one in the Twilio console (Phone Numbers).
# Format: E.164 (e.g. +18001234567)
TWILIO_PHONE_NUMBER=

# ── Twilio WhatsApp Sandbox ─────────────────────────────────────────
# Default sandbox number is whatsapp:+14155238886
# To enable: Twilio Console → Messaging → Try it out → WhatsApp sandbox
# Each tester must first send "join <your-sandbox-code>" to this number.
TWILIO_WHATSAPP_FROM=

# ── Public URL (ngrok) ──────────────────────────────────────────────
# Twilio needs a publicly reachable URL for webhooks.
# 1. Run: ngrok http 3001
# 2. Copy the https:// URL here
# 3. Configure Twilio webhooks to point to:
#    Voice:    {BASE_URL}/voice/incoming
#    WhatsApp: {BASE_URL}/whatsapp/incoming
BASE_URL=https://xxxx.ngrok-free.app

# ── Shared Backend ──────────────────────────────────────────────────
# Track C's FastAPI server (the one running in /backend with uvicorn)
BACKEND_URL=http://localhost:8000

# ── Server ──────────────────────────────────────────────────────────
PORT=3001

# ── Tesseract OCR Binary (Windows) ──────────────────────────────────
# Download installer: https://github.com/UB-Mannheim/tesseract/wiki
# During installation, check "Additional language data" → select Hindi.
# Uncomment and set path if tesseract is NOT in your system PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
