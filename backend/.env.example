# ── Kaarigar backend configuration ──────────────────────────────
# Everything here is OPTIONAL. With no .env at all, the backend runs on a
# local SQLite file with mock (fake) payments — perfect for the demo.
# Fill in values only when you need real services.

# Supabase (leave blank to use the local SQLite file instead)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Razorpay Test Mode (leave blank to use the built-in mock payment flow).
# Get TEST keys from https://dashboard.razorpay.com  (Test Mode -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Local SQLite database file (used only when SUPABASE_URL is blank)
KAARIGAR_DB=kaarigar.db

# ── Integrations (Required for AI and IVR features) ──────────────

# OpenAI API Key (Required for AI description & category mapping)
OPENAI_API_KEY=

# Photoroom API Key (Required for AI background removal)
PHOTOROOM_API_KEY=

# Twilio Keys (Required to test Voice & WhatsApp IVR)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
